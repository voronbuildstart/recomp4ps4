diff --git a/CMakeLists.txt b/CMakeLists.txt
index 15d8565..ba476e8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -31,6 +31,7 @@ if (WIN32)
 endif()
 
 set(RT64_STATIC TRUE)
+set(RT64_DIR "${CMAKE_SOURCE_DIR}/lib/rt64")
 add_subdirectory(${CMAKE_SOURCE_DIR}/lib/rt64 ${CMAKE_BINARY_DIR}/rt64)
 
 # set(BUILD_SHARED_LIBS_SAVED "${BUILD_SHARED_LIBS}")
@@ -47,8 +48,12 @@ target_compile_options(rt64 PRIVATE -Wno-error -Wno-deprecated-literal-operator)
 if (WIN32)
     target_compile_options(rt64 PRIVATE /FIintrin.h)
 endif()
-target_compile_options(texture_hasher PRIVATE -Wno-error)
-target_compile_options(texture_packer PRIVATE -Wno-error)
+if (TARGET texture_hasher)
+    target_compile_options(texture_hasher PRIVATE -Wno-error)
+endif()
+if (TARGET texture_packer)
+    target_compile_options(texture_packer PRIVATE -Wno-error)
+endif()
 
 # RecompiledFuncs - Library containing the primary recompiler output
 add_library(RecompiledFuncs STATIC)
@@ -121,6 +126,16 @@ add_custom_command(OUTPUT ${CMAKE_SOURCE_DIR}/RecompiledPatches/patches_bin.c
     DEPENDS ${CMAKE_SOURCE_DIR}/patches/patches.bin
 )
 
+# The recompiler that generates the patch code runs on the build machine (host libc): the PC
+# toolchain's N64Recomp of this tree.
+if (PS4)
+    if (DEFINED ENV{R4P_PC_N64RECOMP})
+        set(RT64_HOST_N64RECOMP "$ENV{R4P_PC_N64RECOMP}")
+    else()
+        set(RT64_HOST_N64RECOMP "/home/bitten/recomp4ps4/projects/Kirby64Recomp/build-pc/N64Recomp/N64Recomp")
+    endif()
+endif()
+
 # # Recompile patches elf into patches.c and patches.bin
 add_custom_command(OUTPUT
                        ${CMAKE_SOURCE_DIR}/patches/patches.bin
@@ -128,7 +143,7 @@ add_custom_command(OUTPUT
                        ${CMAKE_SOURCE_DIR}/RecompiledPatches/recomp_overlays.inl
                        ${CMAKE_SOURCE_DIR}/RecompiledPatches/funcs.h
                    # TODO: Look into why modifying patches requires two builds to take
-                   COMMAND ${CMAKE_BINARY_DIR}/N64Recomp/N64Recomp patches.toml
+                   COMMAND ${RT64_HOST_N64RECOMP} patches.toml
                    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
                    DEPENDS ${CMAKE_SOURCE_DIR}/patches/patches.elf
 )
@@ -288,7 +303,7 @@ if (WIN32)
     target_sources(Kirby64Recompiled PRIVATE ${CMAKE_SOURCE_DIR}/icons/app.rc)
 endif()
 
-if (CMAKE_SYSTEM_NAME MATCHES "Linux")
+if (CMAKE_SYSTEM_NAME MATCHES "Linux" OR DEFINED PS4_SYSROOT)
     find_package(SDL2 REQUIRED)
     # find_package(X11 REQUIRED)
     
@@ -325,7 +340,7 @@ if (CMAKE_SYSTEM_NAME MATCHES "Linux")
     set(THREADS_PREFER_PTHREAD_FLAG TRUE)
     find_package(Threads REQUIRED)
     
-    target_link_libraries(Kirby64Recompiled PRIVATE "-latomic -static-libstdc++" ${CMAKE_DL_LIBS} Threads::Threads)
+    target_link_libraries(Kirby64Recompiled PRIVATE ${CMAKE_DL_LIBS} Threads::Threads)
 endif()
 
 target_link_libraries(Kirby64Recompiled PRIVATE
@@ -338,6 +353,7 @@ target_link_libraries(Kirby64Recompiled PRIVATE
     ultramodern
     librecomp
 )
+target_link_libraries(Kirby64Recompiled PRIVATE -L/home/bitten/kirby64-build/sysroot/lib)
 
 # TODO fix the rt64 CMake script so that this doesn't need to be duplicated here
 # For DXC
@@ -376,4 +392,15 @@ build_pixel_shader (Kirby64Recompiled "shaders/InterfacePS.hlsl" "shaders/Interf
 
 target_sources(Kirby64Recompiled PRIVATE ${SOURCES})
 
-set_property(TARGET Kirby64Recompiled PROPERTY VS_DEBUGGER_WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
\ No newline at end of file
+set_property(TARGET Kirby64Recompiled PROPERTY VS_DEBUGGER_WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
+
+if (PS4)
+    include(${KIRBY64_PS4_DIR}/ps4.cmake)
+
+    # The N64Recomp/RSPRecomp host tools run on the build machine, but the PS4 toolchain swaps the
+    # C runtime's malloc family for the port's wrappers for every executable, so the tools that the
+    # patch generation runs (N64Recomp patches.toml) need the wrappers to link.
+    add_library(ps4_host_malloc_stubs STATIC ${CMAKE_SOURCE_DIR}/src/host/ps4_host_malloc.cpp)
+    target_link_libraries(N64Recomp ps4_host_malloc_stubs)
+    target_link_libraries(RSPRecomp ps4_host_malloc_stubs)
+endif()
