diff --git a/src/host/ps4_host_malloc.cpp b/src/host/ps4_host_malloc.cpp
new file mode 100644
index 0000000..8356ac7
--- /dev/null
+++ b/src/host/ps4_host_malloc.cpp
@@ -0,0 +1,35 @@
+// Kirby64Recomp's PS4 port: host tools (N64Recomp, RSPRecomp) run on the build machine, but the
+// PS4 toolchain swaps the C runtime's malloc family for the port's wrappers for every executable
+// (ps4-love-style.cmake: crt1-malloc-replace swaps crt1.o, so the whole process - host tools
+// included - forwards malloc through the port's heap and calls these wrappers). The wrappers are
+// defined in port/ps4_runtime.cpp, for the console app; host tools only need them to exist.
+
+#include <stdlib.h>
+#include <malloc.h>
+
+extern "C" {
+
+int ps4_replace_malloc_init(void) { return 0; }
+int ps4_replace_malloc_finalize(void) { return 0; }
+void* ps4_replace_malloc(size_t size) { return ::malloc(size); }
+void ps4_replace_free(void* ptr) { ::free(ptr); }
+void* ps4_replace_calloc(size_t nelem, size_t size) { return ::calloc(nelem, size); }
+void* ps4_replace_realloc(void* ptr, size_t size) { return ::realloc(ptr, size); }
+void* ps4_replace_memalign(size_t boundary, size_t size) { return ::memalign(boundary, size); }
+void* ps4_replace_reallocalign(void* ptr, size_t size, size_t boundary) {
+    if (!ptr)
+        return ::memalign(boundary, size);
+    return ptr;
+}
+int ps4_replace_posix_memalign(void** out, size_t boundary, size_t size) {
+    void* p = ::memalign(boundary, size);
+    if (!p)
+        return 12; // ENOMEM
+    *out = p;
+    return 0;
+}
+int ps4_replace_malloc_stats(void* out) { return 0; }
+int ps4_replace_malloc_stats_fast(void* out) { return ps4_replace_malloc_stats(out); }
+size_t ps4_replace_malloc_usable_size(void* ptr) { return ptr ? ::malloc_usable_size(ptr) : 0; }
+
+} // extern "C"
