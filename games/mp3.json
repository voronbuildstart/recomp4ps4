      "Conker's Bad Fur Day": "Mario Party 3",
      "Conker-PS4": "MP3-PS4",
      "Conker": "Mario Party 3",
      "conker.log": "marioparty3.log",
      "conker.prev.log": "marioparty3.prev.log",
      "conker": "mp3"
